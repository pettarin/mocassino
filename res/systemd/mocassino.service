# This file is part of the mocassino project

[Unit]
Description=Lightweight audio player based on MOC for Raspberry Pi Zero 2 devices with Pimoroni Pirate Audio hats
Documentation=https://github.com/pettarin/mocassino
After=sound.target

[Service]
Type=simple
# mocassino must be installed in a venv located at $HOME/.mocassino/venv/
# (%h is the systemd placeholder for the home directory of the user running the service)
ExecStart=%h/.mocassino/venv/bin/mocassino -v run -f
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=yes
# ProtectHome needs to be disabled, since the installation is under $HOME
#ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=default.target
