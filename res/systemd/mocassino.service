# This file is part of the mocassino project

[Unit]
Description=Lightweight audio player based on MOC for Raspberry Pi Zero 2 devices with Pimoroni Pirate Audio hats
Documentation=https://github.com/pettarin/mocassino
After=sound.target

[Service]
Type=simple
# assume mocassino is installed in /opt/mocassino/venv,
# and /opt/mocassino/run exists (acting as the $HOME for the service)
Environment=LG_WD=/opt/mocassino/run
Environment=HOME=/opt/mocassino/run
Environment=XDG_CONFIG_HOME=/opt/mocassino/run/.config
WorkingDirectory=/opt/mocassino/run
ReadWritePaths=/opt/mocassino/run
ExecStart=/opt/mocassino/venv/bin/mocassino -l /music -v run -f
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=default.target
